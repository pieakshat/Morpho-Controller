# RPC endpoint used by test/fork/*.t.sol (vm.createSelectFork, pinned to a fixed block for
# reproducibility). Fork tests fail loudly if this is unset rather than silently skipping,
# so `forge test` never gives false confidence.
#
# Must be an archive-capable endpoint. The public https://arb1.arbitrum.io/rpc only retains
# ~6,000-8,000 blocks (~30 min) of state, which isn't enough to pin a block reliably — use a
# free-tier key from Alchemy, Infura, or QuickNode instead.
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# --- Deployment (script/Deploy.s.sol) -----------------------------------------------
#
# Deploys the vault, registers every market in script/config/<chainid>.json, sets the
# allocator, applies breaker thresholds, and seeds the vault.

# Signs the deployment. Must hold enough of the vault asset to cover seed.amount from the
# chain config, or the script aborts before deploying anything.
DEPLOYER_PRIVATE_KEY=0x

# Granted the allocator role, i.e. the key the off-chain service will sign executeActions
# with. Deliberately not the deployer in production: the allocator is a hot key with a
# bounded blast radius, the owner is not.
ALLOCATOR_ADDRESS=0x

# Optional. Where ownership should end up (multisig). Leave unset to keep the deployer as
# permanent owner, which is what a local fork or solo testnet run wants.
#
# Two things to know before setting this. CircuitBreaker resolves its admin as the vault's
# current owner, so the vault is always deployed owned by the deployer and configured first;
# deploying straight to a multisig would lock the script out of its own setup calls. And
# Ownable2Step means the transfer stays PENDING until the new owner calls acceptOwnership()
# themselves, which no script can do for them.
# VAULT_OWNER=0x

# Signs post-deploy admin scripts (RegisterMarket, ConfigureBreaker). Must be the vault's
# current owner. Once ownership has moved to a multisig, use
# `forge script script/ConfigureBreaker.s.sol --sig "printCalldata()"` instead of this.
# OWNER_PRIVATE_KEY=0x

# Optional, for --verify on a public chain.
# ETHERSCAN_API_KEY=
