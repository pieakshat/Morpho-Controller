# Required.
RPC_URL=https://arb1.arbitrum.io/rpc
CHAIN_ID=42161

# Only for --submit. Reads, planning and simulation all work without it.
# ALLOCATOR_PRIVATE_KEY=0x...

# Addresses come from deployments/<CHAIN_ID>[.<label>].json, written by script/Deploy.s.sol.
# Set the label for fork work: an anvil fork of Arbitrum still reports chainid 42161, so a
# local run writes 42161.local.json rather than overwriting the real record.
# DEPLOYMENT_LABEL=local
# DEPLOYMENTS_DIR=/abs/path/to/deployments

# Simulating a bundle runs a full DEX route, and on a forked node every untouched storage slot
# is an upstream fetch. viem's 10s default times out on exactly that call.
RPC_TIMEOUT_MS=60000

# pending (default) is the state the transaction will execute against. Use latest ONLY on a
# long-lived fork, where anvil stamps pending with wall-clock time while latest stays frozen
# near the forked block: once that gap grows, live DEX routes stop executing and the batch is
# blamed for it. Measured: 75s of drift was enough.
# SIMULATE_BLOCK_TAG=latest

# How stale a plan may be at submission, in wall-clock seconds. Seconds rather than blocks
# because what age costs is a price move: the oracle floor a route must clear is recomputed
# from the live price at execution, and the same block count means seconds on one chain and
# minutes on another. On this market the 50 bps floor has roughly 28 bps left after an honest
# route's spread and price impact, and 45s stays comfortably inside that.
# MAX_PLAN_AGE_SECONDS=45

# Backstop only, against a node reporting a frozen or wrong timestamp. Should never fire ahead
# of the seconds budget on a healthy chain.
# MAX_PLAN_AGE_BLOCKS=600

# Our own bound on top of the oracle floor the contract enforces regardless.
# QUOTE_SLIPPAGE_BPS=50
# ACCRUAL_BUFFER_BPS=25

# MULTICALL3_ADDRESS=0xcA11bde05977b3631167028862bE2a173976CA11
# VELORA_BASE_URL=https://api.paraswap.io
# VELORA_PARTNER=anon
