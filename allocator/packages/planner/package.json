    "capture:velora": "tsx scripts/capture-velora.ts"
  },
  "dependencies": {
    "@morphoagg/core": "workspace:*",
    "viem": "^2.56.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "tsx": "^4.19.2"
  }
